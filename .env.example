# Generate a private local token with: python scripts/configure_local.py
SUPPORTPILOT_DATABASE_URL=sqlite:///.state/supportpilot.db
SUPPORTPILOT_API_TOKENS_JSON=[]
SUPPORTPILOT_MODE=fixture
# For live mode, configure the key and choose a model available to your account.
SUPPORTPILOT_OPENAI_API_KEY=
SUPPORTPILOT_MODEL=gpt-4.1-mini
SUPPORTPILOT_EMBEDDING_MODEL=text-embedding-3-small
# Optional dated pricing: unset values display cost as unavailable.
# SUPPORTPILOT_INPUT_USD_PER_MILLION=
# SUPPORTPILOT_OUTPUT_USD_PER_MILLION=
# SUPPORTPILOT_EMBEDDING_USD_PER_MILLION=
# SUPPORTPILOT_PRICING_DATE=

# GitHub OAuth connection (optional); never commit real credentials.
SUPPORTPILOT_GITHUB_CLIENT_ID=
SUPPORTPILOT_GITHUB_CLIENT_SECRET=
SUPPORTPILOT_GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/callback
# Generate a Fernet key once and retain it securely across restarts/deployments.
SUPPORTPILOT_INTEGRATION_ENCRYPTION_KEY=
